APP_ENV=development
APP_NAME=AgriGuard
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=agriguard-dev-secret-key-please-change-in-production-2024
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:3001,https://localhost,capacitor://localhost,ionic://localhost
PUBLIC_URL=https://tire-stability-specialists-benefit.trycloudflare.com

# ── AI Assistant (Anthropic Claude) ─────────────────────────────────────────
# Set ANTHROPIC_API_KEY to your real key from console.anthropic.com
# Without a key, the assistant falls back to the local RAG synthesis engine.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.3

# ── Cloudflare Named Tunnel (optional — gives a permanent, fixed HTTPS URL) ──────
# Leave blank/commented to use Quick Tunnel (free public HTTPS URL on trycloudflare.com).
# Named Tunnel 'agriguard' (ID: 3f1026e8-97ed-4cff-a247-d253e5d91e7e) is already created in your account.
# To use it, add a domain to Cloudflare, route a Public Hostname to http://localhost:8000, then uncomment:
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiOTdlZmQzNjhjZjg5ZTU2MWE5YjA1NGZlYmE2YThiYTYiLCJ0IjoiM2YxMDI2ZTgtOTdlZC00Y2ZmLWEyNDctZDI1M2U1ZDkxZTdlIiwicyI6IkYrY1dnRzFlY3lBc2ZScU5UMzFjblZQdUJDcCtoSC8vRVNQc1prb1Rka1c4cUVQM0ZodUNyZUV6MU50b0FrZVdhVHR5cGRNUDJQU0FWYWhEQWpCc2dnPT0ifQ==

DATABASE_URL=sqlite:///c:/sih3/backend/agriguard.db

JWT_SECRET_KEY=agriguard-jwt-secret-key-please-change-in-production-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

ML_MODEL_PATH=./uploads/models/best_model.pt
ML_CONFIDENCE_HIGH=0.80
ML_CONFIDENCE_MEDIUM=0.60
ML_DEVICE=cpu

OPENWEATHER_API_KEY=demo
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

REDIS_URL=redis://localhost:6379/0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agriguard.app

STORAGE_TYPE=local
